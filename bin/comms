#!/bin/bash
# comms -- thin dispatcher over the comms stack (lib/).
#
# ROUTER, NOT A SECOND IMPLEMENTATION: this script only picks which module a
# subcommand belongs to, then execs that module's own CLI with the remaining
# arguments passed through verbatim. exec preserves the module's exit code by
# construction; no argument is re-parsed, no business logic lives here. The
# modules' docstrings are the authority on arguments and exit codes.
#
# lib/ is resolved relative to THIS script's location (the checkout it lives
# in), never a hardcoded home, so a clone anywhere on any machine routes to
# its own copy.

set -u

# Chase symlinks before locating the checkout: a PATH install is usually a
# symlink into ~/bin, and dirname of the SYMLINK points at the wrong tree
# (caught by the verifier seat, run comms-build-0821: rc=2 masquerading as
# the usage code, or silent execution of a foreign lib copy).
SELF="$0"
while [ -L "$SELF" ]; do
  target="$(readlink "$SELF")"
  case "$target" in
    /*) SELF="$target" ;;
    *)  SELF="$(dirname "$SELF")/$target" ;;
  esac
done
SELF_DIR="$(cd "$(dirname "$SELF")" && pwd -P)"   # <repo>/bin
REPO_ROOT="$(cd "$SELF_DIR/.." && pwd)"           # <repo>
LIB="$REPO_ROOT/lib"

usage() {
  cat >&2 <<'EOF'
usage: comms <subcommand> [args ...]

mailbox (lib/swarm_mailbox.py; exit 0 ok, 1 bad args, 2 usage):
  init      <runid>
  subscribe <runid> <seat> <topic> [<topic> ...]
  post      <runid> <seat> <kind> <text> [--topic <name> | --to <seat>] [--thread <key>]
  post      <kind> <text> [--topic <name> | --to <seat>] [--thread <key>]
            (SHORT FORM, no explicit <runid>/<seat>: this wrapper fills them
             from COMMS_RUN (default machine-ops) and COMMS_SEAT (default:
             this session's own ambient seat, resolved the SAME way
             sendmessage-bridge.sh resolves it -- via CLAUDE_SESSION_ID's
             enrollment in machine-ops -- never a second derivation). Used to
             reply into a thread a peer's row named: swarm-heartbeat.sh
             suffixes an injected row with " (thread <key>)" when it carries
             one, and `--thread <key>` on the reply below carries that key
             back, so both sides render under the same thread:
               comms post reply --to <seat> --thread <key> "<text>"
             The 4-positional form above still works when <runid>/<seat> are
             given explicitly.)
  read      <runid> <seat> [--topic <name>] [--replay]
            (NEW rows only: a per-(runid, seat, filter) cursor under
             COMMS_STATE_DIR advances once the rows are printed.
             --replay prints the whole board and leaves the cursor alone.
             Piping through head/tail truncates the OUTPUT, not the cursor:
             it advances over every row the view selected, so rows you cut
             off come back only via --replay. Consume a read whole.)
  subs      <runid> <seat>          (this seat's subscribed slice; = read --subs)
  cursor take    <path>             (rows as JSONL on stdin; prints a receipt
                                     line then the fresh rows, writes NOTHING)
  cursor confirm <path> <receipt>   (commits that receipt)
            (the confirmed-delivery cursor for shell drivers: deliver the rows
             first, confirm only if the delivery exited 0, and a failed
             delivery re-delivers instead of dropping. Feed it from
             `comms read ... --replay` -- read's own cursor commits at print
             time, and two cursors over one stream is one too many.
             See bin/comms-poll-driver.)

metrics (lib/swarm_threads.py; exit 0 ok, 2 usage or the positive control --
        threads_inspected == 0, "inspected nothing" is never a quiet pass):
  threads   [--alive SECONDS] [--seats N] [--run RUNID | --all-runs] [--json]
            (groups the mailbox's threaded rows by document, prints
             threads_inspected/threads_alive/threads_exchange and, per thread
             key, alive/exchange/seats/rows/last_gap_s. Defaults come from
             COMMS_THREAD_ALIVE_SECONDS (1800) / COMMS_THREAD_ALIVE_SEATS (2),
             the same knobs the Discord board lane reads.)

arming (lib/swarm_arm.py; exit 0 ok, 1 not-armed, 2 usage):
  arm       <runid> [--topic <set>]
  disarm    <runid>
  enroll    <runid> [--agent-id <id>] [--topics <set>] [--seat <name>]
            [--model <name>] [--project <repo>] [--area <path>]
            (model/project/area: free-text identity for dashboards, e.g.
             --model "Kimi K3" --project agent-os --area hooks/)
  status    [<runid>]

claims (lib/swarm_claims.py; exit 0 ok, 1 conflict/refused/nothing-reaped,
        2 usage, 3 not-armed):
  claim     <runid> <owner> <path> [<path> ...]
  release   <runid> <owner> <path> [<path> ...]
  who       <runid> [<path>]
  reap      <runid> <owner>
EOF
  exit 2
}

# This session's own seat, resolved EXACTLY the way
# adapters/claude-code/ambient/sendmessage-bridge.sh resolves it (a single
# swarm_arm.participant_sub lookup on CLAUDE_SESSION_ID) -- not a second,
# possibly-diverging derivation. Empty output means unresolvable (no session
# id, or that session id is not enrolled in <runid>).
_comms_default_seat() {  # _comms_default_seat <runid>
  local runid="$1"
  local agent="${CLAUDE_SESSION_ID:-}"
  [ -n "$agent" ] || return 0
  local state_dir="${COMMS_STATE_DIR:-$HOME/.comms/state}"
  COMMS_CDS_LIB="$LIB" COMMS_CDS_STATE="$state_dir" COMMS_CDS_RUN="$runid" \
  COMMS_CDS_AGENT="$agent" python3 - <<'PY'
import os
import sys
sys.path.insert(0, os.environ.get("COMMS_CDS_LIB") or "")
import swarm_arm
_topics, seat = swarm_arm.participant_sub(
    os.environ.get("COMMS_CDS_RUN"),
    os.environ.get("COMMS_CDS_AGENT"),
    state_dir=os.environ.get("COMMS_CDS_STATE"),
)
sys.stdout.write(seat or "")
PY
}

[ "$#" -ge 1 ] || usage
sub="$1"
shift

case "$sub" in
  post)
    # SHORT FORM (issue #41): `comms post <kind> <text> [flags]` with no
    # explicit <runid>/<seat> -- count POSITIONAL (non-flag) args; the module
    # needs exactly 4 (runid seat kind text). Exactly 2 means runid/seat were
    # omitted, so fill them from env defaults. Any other count (0, 1, 3, 4+)
    # passes through unchanged, so the pre-#41 explicit form and the module's
    # own usage errors are untouched.
    n=0
    skip=0
    for a in "$@"; do
      if [ "$skip" = 1 ]; then skip=0; continue; fi
      case "$a" in
        --topic|--to|--thread) skip=1 ;;
        --*) ;;
        *) n=$((n + 1)) ;;
      esac
    done
    if [ "$n" -eq 2 ]; then
      run="${COMMS_RUN:-machine-ops}"
      seat="${COMMS_SEAT:-}"
      [ -n "$seat" ] || seat="$(_comms_default_seat "$run")"
      if [ -z "$seat" ]; then
        printf 'comms: post short form needs COMMS_SEAT, or an enrolled CLAUDE_SESSION_ID\n' >&2
        exit 1
      fi
      exec python3 "$LIB/swarm_mailbox.py" post "$run" "$seat" "$@"
    fi
    exec python3 "$LIB/swarm_mailbox.py" post "$@"
    ;;
  init|subscribe|read|cursor)
    exec python3 "$LIB/swarm_mailbox.py" "$sub" "$@"
    ;;
  subs)
    # The one aliased spelling: the mailbox module expresses this as a flag on
    # read, so the router appends that flag. Still the module's logic.
    exec python3 "$LIB/swarm_mailbox.py" read "$@" --subs
    ;;
  threads)
    # PURE EXEC (issue #43): swarm_threads.py's own main() already expects
    # argv[1] to be the subcommand name, so this is nothing more than the
    # same router pattern every other case above uses -- no arg is
    # re-parsed, no env default is injected, the module's own docstring is
    # the authority on flags and exit codes.
    exec python3 "$LIB/swarm_threads.py" threads "$@"
    ;;
  arm|disarm|enroll|status)
    exec python3 "$LIB/swarm_arm.py" "$sub" "$@"
    ;;
  claim|release|who|reap)
    exec python3 "$LIB/swarm_claims.py" "$sub" "$@"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    printf 'comms: unknown subcommand %q\n' "$sub" >&2
    usage
    ;;
esac
